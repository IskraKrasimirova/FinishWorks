@model IEnumerable<FinishWorks.Models.ServiceItem>
@{
    ViewData["Title"] = "Нашите Услуги и Цени";
}

<!-- Header Banner -->
<section class="bg-dark text-white py-5" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="container py-4 text-center">
        <h1 class="display-4 fw-bold mb-3">Услуги и Цени</h1>
        <p class="lead text-muted-light max-w-2xl mx-auto" style="color: #cbd5e1;">
            Разгледайте нашите професионални услуги за довършителни работи. Ние предлагаме прозрачни цени, качествени материали и гарантиран краен резултат.
        </p>
    </div>
</section>

<!-- Services Grid -->
<section class="py-5">
    <div class="container py-4">
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var service in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 border-0 shadow-sm transition-transform style-card">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="feature-icon me-3 mb-0">
                                        <i class="bi @service.IconPath"></i>
                                    </div>
                                    <h3 class="h5 card-title mb-0">@service.Name</h3>
                                </div>
                                <p class="card-text text-muted flex-grow-1">@service.Description</p>
                                <div class="border-top pt-3 mt-3 d-flex align-items-center justify-content-between">
                                    <span class="small text-muted fw-semibold">Цена:</span>
                                    <span class="fs-5 fw-bold text-primary">@service.Price</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Няма намерени услуги в момента. Моля, свържете се с нас за повече информация.</p>
                </div>
            }
        </div>

        <div class="card bg-light border-0 shadow-sm p-4 mt-4">
            <p class="text-muted mb-0"><i class="bi bi-info-circle-fill text-primary me-2"></i>В посочените цени не е включена стойността на материалите. Окончателната цена подлежи на договаряне в зависимост от обема на работата, сложността и специфичните изисквания.</p>
        </div>
        
        <div class="card bg-light border-0 shadow-sm p-4 mt-5">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h4 class="mb-2">Не намирате услугата, която търсите?</h4>
                    <p class="text-muted mb-md-0">Ние извършваме и много други специфични и нестандартни ремонтни и довършителни дейности по индивидуален проект.</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-controller="Contact" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-telephone me-2"></i>Запитване за Оферта
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .style-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .style-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }
    </style>
}