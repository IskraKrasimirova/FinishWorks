@model FinishWorks.Models.ContactFormModel
@{
    ViewData["Title"] = "Контакти и Запитвания";
}

<!-- Header Banner -->
<section class="bg-dark text-white py-5" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="container py-4 text-center">
        <h1 class="display-4 fw-bold mb-3">Свържете се с нас</h1>
        <p class="lead text-muted-light max-w-2xl mx-auto" style="color: #cbd5e1;">
            Готови сме да обсъдим Вашия проект и да Ви предложим най-доброто решение. Попълнете формата за контакт за безплатен оглед и консултация.
        </p>
    </div>
</section>

<!-- Contact & Form Section -->
<section class="py-5">
    <div class="container py-4">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-5 p-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Успешно изпратено запитване!</h5>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-5">
            <!-- Contact Info -->
            <div class="col-lg-5">
                <div class="bg-white p-4 p-md-5 rounded shadow-sm h-100">
                    <h3 class="mb-4">Информация за връзка</h3>
                    <p class="text-muted mb-4">Нашият екип е на Ваше разположение за всякакви въпроси, консултации и уговаряне на часове за безплатни огледи.</p>
                    
                    <div class="d-flex mb-4">
                        <div class="feature-icon me-3 flex-shrink-0">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <h5 class="mb-1">Офис & Локация</h5>
                            <p class="text-muted mb-0">гр. София, България</p>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="feature-icon me-3 flex-shrink-0">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <h5 class="mb-1">Телефонен номер</h5>
                            <p class="text-muted mb-0">+359 888 123 456</p>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="feature-icon me-3 flex-shrink-0">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <h5 class="mb-1">Имейл адрес</h5>
                            <p class="text-muted mb-0">momchil404@gmail.com</p>
                        </div>
                    </div>

                    <div class="d-flex">
                        <div class="feature-icon me-3 flex-shrink-0">
                            <i class="bi bi-clock-fill"></i>
                        </div>
                        <div>
                            <h5 class="mb-1">Работно време</h5>
                            <p class="text-muted mb-0">Понеделник - Събота: 08:00 - 18:00 ч.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="col-lg-7">
                <div class="bg-white p-4 p-md-5 rounded shadow-sm h-100">
                    <h3 class="mb-4">Изпратете запитване</h3>
                    <form asp-controller="Contact" asp-action="Index" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Вашето име <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="Name" class="form-control" placeholder="Иван Иванов" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold">Телефон за контакт <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="0888123456" required />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Имейл адрес <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" type="email" placeholder="email@example.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Message" class="form-label fw-semibold">Описание на ремонта / запитване <span class="text-danger">*</span></label>
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="Моля, опишете накратко от какви услуги имате нужда и приблизителните размери на помещенията..." required></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-send me-2"></i>Изпрати Запитване
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Client-side jQuery validation scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
}